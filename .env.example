# Feedback service configuration

# SQLite database file location
DB_PATH=data/feedback.db

# Directory where uploaded screenshots are stored
SCREENSHOTS_DIR=screenshots

# Admin dashboard login
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-long-random-string

# Public base URL of this service, used for links in webhook payloads and the
# embed snippet. Include the base path here if you set one, e.g.
# https://feedback.example.com/feedback
ADMIN_BASE_URL=https://feedback.example.com

# Optional sub-path the app is served under, e.g. /feedback. Empty/omitted for
# the domain root. Must be set at build time (it is baked into the client
# bundle), so rebuild the image/container when changing it.
NEXT_PUBLIC_BASE_PATH=
